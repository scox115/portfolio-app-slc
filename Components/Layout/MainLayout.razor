@inherits LayoutComponentBase

<div class="page">
    <header class="site-nav">
        <a href="/" class="brand">Scott Cox</a>
        <nav aria-label="Site">
            <a href="/#projects">Projects</a>
            <a href="/resume">Résumé</a>
            <a href="/blog">Blog</a>
            <a href="https://github.com/scox115" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/scox115" target="_blank" rel="noopener">LinkedIn</a>
            @if (!string.IsNullOrEmpty(SiteInfo.Email))
            {
                <button type="button" class="nav-contact" popovertarget="contact-popover">Contact</button>
            }
        </nav>
    </header>

    <main>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (!string.IsNullOrEmpty(SiteInfo.Email))
{
    <ContactPopover />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
