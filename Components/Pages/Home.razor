@page "/"
@rendermode InteractiveServer

<PageTitle>Portfolio | Home</PageTitle>

<div class="portfolio-container">
    <header class="hero-section">
        <div class="profile-frame">
            <img src="images/profile.jpg" alt="Scott Cox" class="profile-img" />
        </div>

        <h1 class="headline">Hi, I'm <span class="highlight">Scott Cox</span></h1>
        <p class="subtitle">Software Developer / .NET</p>

        <nav class="social-links" aria-label="Profiles">
            <a href="https://github.com/scox115" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/scox115" target="_blank" rel="noopener">LinkedIn</a>
            <a href="/resume">Résumé</a>
        </nav>
    </header>

    <section class="bio-section">
        <h2>About Me</h2>
        <p class="bio-text">
            I am a results-driven Full-Stack Software Developer specializing in building modern web applications with C#,
            .NET, Azure, and Blazor. I thrive at the intersection of robust backend architecture and dynamic frontend design,
            transforming complex requirements into clean, scalable software. My professional approach is rooted in writing maintainable code,
            leveraging cloud-native environments, and ensuring that every application I build delivers a seamless, responsive user experience.
        </p>
        <p class="bio-text">
            Throughout my career, I have focused on solving the technical friction points that slow down application performance and cloud deployment.
            I excel at architecting single-page applications with Blazor, optimizing C# .NET APIs for high-throughput data processing, and designing secure,
            cost-effective infrastructure inside Azure. Whether it is refactoring legacy monolithic systems into agile cloud services, tuning database queries,
            or automating CI/CD pipelines, I look at software through a holistic lens to eliminate bottlenecks and reduce technical debt.
        </p>
        <p class="bio-text">
            What drives my work is the tangible impact of well-crafted technology. I am deeply motivated by the challenge of cloud optimization—finding the most elegant,
            secure, and resource-efficient ways to scale applications globally. By blending a rigorous engineering mindset with an eye for user-centric frontend design,
            I bring a unique value to engineering teams: the ability to own a feature from the database layer to the browser, ensuring your development cycle stays fast, reliable, and aligned with business goals.
        </p>

        <p class="bio-text">
            When I'm not coding or working on projects, I focus on staying updated with industry trends.
        </p>

        <div class="cta-container">
            <a href="/resume" class="btn-primary">View Full Resume</a>
        </div>
    </section>

    <section class="projects-section">
        <h2>Project Showcase</h2>

        <div class="filter-bar">
            <button class="btn-filter @(selectedTag == "All" ? "active" : "")" @onclick='() => FilterProjects("All")'>All</button>
            @foreach (var tag in availableTags)
            {
                <button class="btn-filter @(selectedTag == tag ? "active" : "")" @onclick="() => FilterProjects(tag)">@tag</button>
            }
        </div>

        <div class="project-grid">
            @foreach (var project in filteredProjects)
            {
                <div class="project-card">
                    <div class="project-meta">
                        <span class="project-type">@project.Type</span>
                    </div>
                    <h3>@project.Title</h3>
                    <p class="project-description">@project.Description</p>
                    <div class="project-tags">
                        @foreach (var tag in project.Tags)
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                    <div class="project-links">
                        @if (!string.IsNullOrEmpty(project.GitHubUrl))
                        {
                            <a href="@project.GitHubUrl" target="_blank" rel="noopener" class="link-icon">GitHub &nearr;</a>
                        }
                        @if (!string.IsNullOrEmpty(project.LiveUrl))
                        {
                            <a href="@project.LiveUrl" target="_blank" rel="noopener" class="link-icon live">Live Demo &nearr;</a>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private string selectedTag = "All";
    private List<string> availableTags = new();
    private List<ProjectItem> filteredProjects = new();

    // TODO: replace these sample projects with real ones. Links are left empty so no card points at a dead URL.
    private List<ProjectItem> allProjects = new()
    {
        new ProjectItem
        {
            Title = "GameAppPortfolio",
            Description = "KINGS OF THE CARD ARENA",
            Type = "Game",
            Tags = new[] { ".NET", "SQL", "Cloud", "Blazor", "Web API" },
            LiveUrl = "https://play.scottcoxdev.com"
        },
        new ProjectItem
        {
            Title = "E-Commerce Cloud Platform",
            Description = "An enterprise microservices web engine handling thousands of real-time transactions with integrated distributed cache architecture.",
            Type = "Web App",
            Tags = new[] { ".NET", "SQL", "Cloud" }
        },
        new ProjectItem
        {
            Title = "Dev Portfolio Hub",
            Description = "A lightweight, modern web portfolio engine built on Blazor with static compilation and highly responsive component caching.",
            Type = "Frontend",
            Tags = new[] { "Blazor", ".NET" }
        },
        new ProjectItem
        {
            Title = "Automated Infrastructure API",
            Description = "A secure RESTful engine managing server instance metadata and dynamic scaling policies via secure JWT protocols.",
            Type = "Backend API",
            Tags = new[] { "Web API", ".NET", "Cloud" }
        },
        new ProjectItem
        {
            Title = "S.O.L.I.D.",
            Description = "Embed SOLID and Design Patterns Explicitly.",
            Type = "Full Stack",
            Tags = new[] { "SOLID", "Design Patterns" }
        }
    };

    protected override void OnInitialized()
    {
        availableTags = allProjects.SelectMany(p => p.Tags).Distinct().Order().ToList();
        filteredProjects = allProjects;
    }

    private void FilterProjects(string tag)
    {
        selectedTag = tag;
        if (tag == "All")
        {
            filteredProjects = allProjects;
        }
        else
        {
            filteredProjects = allProjects.Where(p => p.Tags.Contains(tag)).ToList();
        }
    }

    // internal structural model
    public class ProjectItem
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string[] Tags { get; set; } = Array.Empty<string>();
        public string GitHubUrl { get; set; } = string.Empty;
        public string LiveUrl { get; set; } = string.Empty;
    }
}
