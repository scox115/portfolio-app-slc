@page "/"
@rendermode InteractiveServer
@inject ProjectService ProjectService

<PageTitle>Portfolio | Home</PageTitle>
<SeoTags Title="Scott Cox | .NET Software Developer"
         Description="Portfolio of Scott Cox, a full-stack .NET developer building web apps and APIs with C#, Blazor, ASP.NET Core, SQL Server and Azure." />

<div class="portfolio-container">
    <header class="hero-section">
        <div class="profile-frame">
            <img src="images/profile.jpg" alt="Scott Cox" class="profile-img" />
        </div>

        <h1 class="headline">Hi, I'm <span class="highlight">Scott Cox</span></h1>
        <p class="tagline">Full-stack .NET developer building fast, reliable web apps and APIs.</p>
        <p class="subtitle">10+ years with C#, ASP.NET Core, Blazor and SQL Server · U.S. Navy veteran</p>

        <div class="hero-actions">
            <a href="/#projects" class="btn-primary">See my work</a>
            <a href="/resume" class="btn-secondary">Résumé</a>
            @if (!string.IsNullOrEmpty(SiteInfo.Email))
            {
                <button type="button" class="btn-secondary" popovertarget="contact-popover">Contact me</button>
            }
        </div>

        <ul class="skills" aria-label="Core skills">
            @foreach (var skill in skills)
            {
                <li>@skill</li>
            }
        </ul>
    </header>

    <details class="about">
        <summary>About me</summary>
        <div class="about-body">
            <p>
                I'm a full-stack .NET developer with more than 10 years of experience building web applications and APIs
                in C#, ASP.NET Core, Blazor and SQL Server. At First Citizens Bank I led the move of a mission-critical
                AngularJS application to Angular and an ASP.NET Core Web API. Before that, at Allied Payment Network,
                I migrated a client-facing portal from Angular to Blazor, built high-throughput APIs for payment data,
                and shipped .NET microservices in Docker on Kubernetes through Azure DevOps pipelines.
            </p>
            <p>
                I like owning a feature from the database to the browser: shaping SQL Server schemas and queries,
                keeping APIs fast, and making the interface feel quick. This site is one of those projects too, a Blazor
                app on Azure Container Apps that deploys from GitHub Actions on every merge.
            </p>
            <p>
                Before software, I served six years in the U.S. Navy as an Electronics Technician.
            </p>
        </div>
    </details>

    <section id="projects" class="projects-section">
        <h2>Project Showcase</h2>

        <div class="filter-bar">
            <button class="btn-filter @(selectedTag == "All" ? "active" : "")" @onclick='() => FilterProjects("All")'>All</button>
            @foreach (var tag in availableTags)
            {
                <button class="btn-filter @(selectedTag == tag ? "active" : "")" @onclick="() => FilterProjects(tag)">@tag</button>
            }
        </div>

        <div class="project-grid">
            @foreach (var project in filteredProjects)
            {
                <div class="project-card">
                    @if (!string.IsNullOrEmpty(project.ImageUrl))
                    {
                        <img src="@project.ImageUrl" alt="Screenshot of @project.Title" class="project-image" loading="lazy" />
                    }
                    <div class="project-meta">
                        <span class="project-type">@project.Type</span>
                    </div>
                    <h3>@project.Title</h3>
                    <p class="project-description">@project.Description</p>
                    <div class="project-tags">
                        @foreach (var tag in project.Tags)
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                    <div class="project-links">
                        @if (!string.IsNullOrEmpty(project.GitHubUrl))
                        {
                            <a href="@project.GitHubUrl" target="_blank" rel="noopener" class="link-icon">GitHub &nearr;</a>
                        }
                        @if (!string.IsNullOrEmpty(project.LiveUrl))
                        {
                            <a href="@project.LiveUrl" target="_blank" rel="noopener" class="link-icon live">Live Demo &nearr;</a>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</div>

@code {
    private static readonly string[] skills = [".NET Core", "C#", "ASP.NET Core", "Blazor", "SQL Server", "Azure", "Docker", "Angular"];
    private string selectedTag = "All";
    private IReadOnlyList<Project> allProjects = [];
    private List<string> availableTags = new();
    private IEnumerable<Project> filteredProjects = [];

    protected override void OnInitialized()
    {
        allProjects = ProjectService.Projects;
        availableTags = allProjects.SelectMany(p => p.Tags).Distinct().Order().ToList();
        filteredProjects = allProjects;
    }

    private void FilterProjects(string tag)
    {
        selectedTag = tag;
        filteredProjects = tag == "All" ? allProjects : allProjects.Where(p => p.Tags.Contains(tag));
    }
}
