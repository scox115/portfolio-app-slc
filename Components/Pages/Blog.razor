@page "/blog"
@inject BlogService BlogService

<PageTitle>Portfolio | Blog</PageTitle>
<SeoTags Title="Scott Cox | Blog"
         Description="Notes from Scott Cox on building software with AI, what it gets wrong, and proving developer skills in the age of AI." />

<div class="blog-container">
    <header class="blog-header">
        <h1>Blog</h1>
        <p class="blog-intro">What I'm building with AI coding tools, what they get wrong, and what I'm learning on the job search.</p>
    </header>

    @if (BlogService.Posts.Count == 0)
    {
        <p>The first post is on its way.</p>
    }
    else
    {
        <ul class="post-list">
            @foreach (var post in BlogService.Posts)
            {
                <li class="post-item">
                    <time datetime="@post.Date.ToString("yyyy-MM-dd")">@post.Date.ToString("MMMM d, yyyy")</time>
                    <h2><a href="@($"/blog/{post.Slug}")">@post.Title</a></h2>
                    @if (!string.IsNullOrEmpty(post.Summary))
                    {
                        <p>@post.Summary</p>
                    }
                    <a href="@($"/blog/{post.Slug}")" class="read-more" aria-label="@($"Read {post.Title}")">Read the post</a>
                </li>
            }
        </ul>
    }
</div>
